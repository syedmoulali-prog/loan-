# ====================================================
# CUSTOMER LOAN ELIGIBILITY SYSTEM - BACKEND ENV
# ====================================================

# Port for the Spring Boot server (Default: 8080)
PORT=8080

# Production Database (MySQL)
# Example for Cloud Providers (Railway, Render, AWS RDS, PlanetScale, Aiven):
DB_URL=jdbc:mysql://localhost:3306/customer_loan_system?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password

# JWT Authentication Secret Key (Generate a random 256-bit / 32+ character key)
JWT_SECRET=your_production_256_bit_random_secret_key_change_in_production!
JWT_EXPIRATION_MS=86400000

# File Upload Directory
FILE_UPLOAD_DIR=./uploads

# Spring Profiles: default (persistent file), mysql (external MySQL), test
SPRING_PROFILES_ACTIVE=mysql
